# syntax=docker/dockerfile:1

# R39 compatibility wrapper for the original JetPack R36 MLC stack.
# CUDA 12.6 cubins compiled for SM87 remain compatible with the newer R39
# driver.  The original image failed because its forward-compat libcuda was
# searched before the R39 driver injected by the NVIDIA container runtime.
ARG BASE_IMAGE=dustynv/mlc:0.1.4-r36.4.2
FROM ${BASE_IMAGE}

ENV LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/tvm:/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu

LABEL org.max-test-script.r39-compat="legacy-mlc-0.1.3-tvm-0.18.1-q4f16_ft"
